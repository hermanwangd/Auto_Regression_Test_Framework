  "test": {
    "dsl_version": "v0.3",
    "test_case_id": "NATS-PUBLIC-TC-001",
    "title": "Native public NATS publish returns the exact echo on an owned subject",
    "execute": [
      {
        "id": "publish",
        "target": "event_bus",
        "op": "nats_publish",
        "with": {
          "payload_ref": "artifact://fixtures/payload.json",
          "timeout": "PT2S"
        }
      }
    ],
    "verify": [
      {
        "id": "published",
        "type": "assertion",
        "assert": {
          "actual": "step://publish/published",
          "operator": "equals",
          "expected": "__PUBLISHED__"
        }
      },
      {
        "id": "subject",
        "type": "assertion",
        "assert": {
          "actual": "step://publish/subject",
          "operator": "equals",
          "expected": "__SUBJECT__"
        }
      }
    ]
  },
