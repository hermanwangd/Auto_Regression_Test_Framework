FROM ${JRE_BASE} AS jre
FROM ${PYTHON_BASE}
COPY --from=jre /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk PATH=/opt/java/openjdk/bin:$PATH PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/tool
COPY framework.jar run-sit-postdeploy.py runtime-source-manifest.json entrypoint.sh /opt/tool/
RUN /opt/java/openjdk/bin/java -version && python3 --version && mkdir /output && chown 65532:65532 /output && chmod 0444 /opt/tool/framework.jar /opt/tool/run-sit-postdeploy.py /opt/tool/runtime-source-manifest.json && chmod 0555 /opt/tool/entrypoint.sh
USER 65532:65532
WORKDIR /output
ENTRYPOINT ["/opt/tool/entrypoint.sh"]
